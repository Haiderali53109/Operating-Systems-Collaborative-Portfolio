 {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Segoe UI', sans-serif;
}

body {
  background-color: #f8f9fa;
  color: #333;
}

/* Header */
header {
  background-color: #007bff;
  color: white;
  padding: 1rem 2rem;
  position: sticky;
  top: 0;
}

nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

nav ul {
  list-style: none;
  display: flex;
  gap: 1.5rem;
}

nav a {
  color: white;
  text-decoration: none;
  transition: color 0.3s ease;
}

nav a:hover {
  color: #ffdd57;
}

/* Hero Section */
.hero {
  text-align: center;
  padding: 5rem 2rem;
  background: linear-gradient(135deg, #007bff, #0056b3);
  color: white;
}

.hero button {
  margin-top: 1rem;
  padding: 0.8rem 1.5rem;
  background-color: #ffdd57;
  border: none;
  cursor: pointer;
  font-size: 1rem;
  transition: background 0.3s ease;
}

.hero button:hover {
  background-color: #ffc107;
}

.about, .contact {
  padding: 3rem 2rem;
  text-align: center;
}

/* Footer */
footer {
  background-color: #007bff;
  color: white;
  text-align: center;
  padding: 1rem;
  margin-top: 2rem;
}
